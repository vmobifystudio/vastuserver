<taglib xmlns="http://java.sun.com/xml/ns/j2ee" 
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee/web-jsptaglibrary_2_0.xsd" 
    version="2.0">

    <tlib-version>2.0</tlib-version>
    <uri>http://www.your-domain.com/taglib</uri>

    <function>
        <name>contains</name>
        <function-class>com.sudosaints.vastu.web.CustomTags</function-class>
        <function-signature>boolean contains(java.lang.Object[], java.lang.Object)</function-signature>
    </function>
    
    <function>
    	<name>generateCipher</name>
    	<function-class>com.sudosaints.vastu.web.CustomTags</function-class>
    	<function-signature>java.lang.String generateCipher(java.lang.Long)</function-signature>
    </function>
    
    <function>
    	<name>isStoreOwnerPlanExpiring</name>
    	<function-class>com.sudosaints.vastu.web.CustomTags</function-class>
    	<function-signature>boolean isStoreOwnerPlanExpiring(com.sudosaints.vastu.model.StoreOwnerPlan)</function-signature>
    </function>
</taglib>